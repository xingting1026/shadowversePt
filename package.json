{
  "name": "shadowverse-pt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bench:training": "node --require ./training/tsx-user-shim.cjs --import tsx training-bench.ts",
    "verify:model": "node --require ./training/tsx-user-shim.cjs --import tsx training-browser-parity.ts",
    "test": "npm run build && npm run test:engine",
    "test:engine": "node --require ./training/tsx-user-shim.cjs --import tsx --test tests/game-engine.test.ts"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  }
}
